# Copy to .env for local dev. Never commit the real .env.

# HTTP port the API listens on.
PORT=8080

# Path to the SQLite database file. Parent directory is created if missing.
DB_PATH=./data/marketplace.db

# Directory where uploaded jars/images are stored on disk.
UPLOAD_DIR=./data/uploads

# Origin allowed by CORS (the web-node frontend, once it exists).
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Shared secret required on the X-Internal-Secret header for
# /internal/v1/scan-jobs/* calls (the future Rust worker's callback). Leave
# unset to keep those routes disabled (they 403 without it).
INTERNAL_SHARED_SECRET=change-me-in-prod

# DEV ONLY: when true, uploaded versions are auto-approved immediately
# instead of waiting on the (not-yet-built, Phase 4) scan pipeline. Must be
# false/unset once the Rust worker is wired up.
DEV_AUTO_APPROVE=true

# Whether the session cookie gets the Secure flag. Keep false for local
# http://localhost dev; set true once served over HTTPS (production).
COOKIE_SECURE=false

# Cookie Domain attribute. Leave unset for local dev (both frontend and API
# on localhost). Required in production if the frontend and API live on
# different subdomains (e.g. mc-marketplace.corelabs.network vs
# mc-api.corelabs.network) — set it to the shared parent domain, e.g.
# ".corelabs.network", or the session cookie never reaches the frontend.
COOKIE_DOMAIN=

# Note: no separate SESSION_SIGNING_KEY is used. Sessions and API keys are
# opaque random tokens (crypto/rand); only their SHA256 hash is ever stored,
# so there's nothing for a signing key to add here.
