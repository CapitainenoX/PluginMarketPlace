# Copy to .env (Docker Compose) or split across /etc/mcmarket/{api,workers,web}.env
# (systemd EnvironmentFile). Never commit the real file.

# --- api-go ---
PORT=8080
DB_PATH=./data/marketplace.db
UPLOAD_DIR=./data/uploads
CORS_ALLOWED_ORIGIN=https://mc-marketplace.corelabs.network
DEV_AUTO_APPROVE=false
COOKIE_SECURE=true
# Base URL api-go uses to call the Rust worker synchronously after upload.
WORKER_INTERNAL_URL=http://127.0.0.1:8081
# Shared secret api-go sends on the X-Internal-Secret header when calling
# workers-rust. Must match INTERNAL_SHARED_SECRET below exactly.
INTERNAL_SHARED_SECRET=change-me-generate-a-long-random-value

# --- workers-rust ---
# Same value as api-go's, checked on the X-Internal-Secret header of every
# workers-rust request.
INTERNAL_SHARED_SECRET=change-me-generate-a-long-random-value
BIND_HOST=127.0.0.1

# --- web-node ---
# Browser-facing API origin (through the Cloudflare Tunnel in production).
NEXT_PUBLIC_API_URL=https://mc-api.corelabs.network
# Server-side (SSR/API-route) calls to the Go API — same-host, skips the
# tunnel round trip.
API_INTERNAL_URL=http://127.0.0.1:8080

# --- mcp-server ---
API_BASE_URL=https://mc-api.corelabs.network
# Bearer token for an api_keys row with scope=mcp, created via the dashboard.
MCP_API_KEY=mcp_replace-with-a-real-key
